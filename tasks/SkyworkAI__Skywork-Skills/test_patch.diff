+import importlib
+import sys
+from pathlib import Path
+
+import pytest
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+PPT_SCRIPTS = REPO_ROOT / "skywork-ppt" / "scripts"
+MUSIC_SCRIPTS = REPO_ROOT / "skywork-music-maker" / "scripts"
+
+
+@pytest.fixture(scope="module")
+def local_pptx_ops():
+    pytest.importorskip("pptx")
+    pytest.importorskip("lxml")
+    sys.path.insert(0, str(PPT_SCRIPTS))
+    try:
+        yield importlib.import_module("local_pptx_ops")
+    finally:
+        sys.path.remove(str(PPT_SCRIPTS))
+
+
+@pytest.fixture(scope="module")
+def mureka():
+    pytest.importorskip("requests")
+    sys.path.insert(0, str(MUSIC_SCRIPTS))
+    try:
+        yield importlib.import_module("mureka")
+    finally:
+        sys.path.remove(str(MUSIC_SCRIPTS))
+
+
+def test_parse_slide_spec_sorts_and_deduplicates(local_pptx_ops):
+    result = local_pptx_ops.parse_slide_spec(" 3, 1, 3, 5-7, 6 ", total=7)
+
+    assert result == [0, 2, 4, 5, 6]
+
+
+def test_parse_slide_spec_ignores_empty_parts(local_pptx_ops):
+    assert local_pptx_ops.parse_slide_spec(" , 2, ,4, ", total=5) == [1, 3]
+    assert local_pptx_ops.parse_slide_spec("", total=5) == []
+
+
+def test_parse_slide_spec_accepts_single_element_range(local_pptx_ops):
+    assert local_pptx_ops.parse_slide_spec("2-2", total=4) == [1]
+
+
+def test_parse_slide_spec_descending_range_produces_no_indices(local_pptx_ops):
+    assert local_pptx_ops.parse_slide_spec("4-2", total=5) == []
+
+
+@pytest.mark.parametrize(
+    "spec,total",
+    [
+        ("0", 5),
+        ("6", 5),
+        ("0-2", 5),
+        ("4-6", 5),
+    ],
+)
+def test_parse_slide_spec_rejects_out_of_bounds_values(
+    local_pptx_ops, spec, total
+):
+    with pytest.raises(ValueError):
+        local_pptx_ops.parse_slide_spec(spec, total)
+
+
+def test_parse_order_spec_preserves_requested_order(local_pptx_ops):
+    result = local_pptx_ops.parse_order_spec(" 3, 1, 4, 2 ", total=4)
+
+    assert result == [2, 0, 3, 1]
+
+
+def test_parse_order_spec_allows_partial_and_empty_orders(local_pptx_ops):
+    assert local_pptx_ops.parse_order_spec("3,1", total=4) == [2, 0]
+    assert local_pptx_ops.parse_order_spec(" , ", total=4) == []
+
+
+@pytest.mark.parametrize("spec", ["1,1", "2, 3, 2"])
+def test_parse_order_spec_rejects_duplicates(local_pptx_ops, spec):
+    with pytest.raises(ValueError):
+        local_pptx_ops.parse_order_spec(spec, total=4)
+
+
+@pytest.mark.parametrize("spec", ["0", "5", "1,5"])
+def test_parse_order_spec_rejects_out_of_bounds_values(local_pptx_ops, spec):
+    with pytest.raises(ValueError):
+        local_pptx_ops.parse_order_spec(spec, total=4)
+
+
+def test_mureka_headers_use_explicit_api_key(mureka, monkeypatch):
+    monkeypatch.delenv("MUREKA_API_KEY", raising=False)
+
+    assert mureka.headers("explicit-key") == {
+        "Authorization": "Bearer explicit-key",
+        "Content-Type": "application/json",
+    }
+
+
+def test_mureka_headers_fall_back_to_environment_api_key(mureka, monkeypatch):
+    monkeypatch.setenv("MUREKA_API_KEY", "environment-key")
+
+    assert mureka.headers() == {
+        "Authorization": "Bearer environment-key",
+        "Content-Type": "application/json",
+    }
+
+
+def test_mureka_get_api_key_exits_when_environment_variable_is_missing(
+    mureka, monkeypatch
+):
+    monkeypatch.delenv("MUREKA_API_KEY", raising=False)
+
+    with pytest.raises(SystemExit) as exc_info:
+        mureka.get_api_key()
+
+    assert exc_info.value.code == 1
