+import importlib
+
+
+def test_scripts_package_is_importable():
+    module = importlib.import_module("scripts")
+    assert module.__name__ == "scripts"
+
+
+def test_inference_packages_are_importable():
+    real = importlib.import_module("inference.real")
+    robotwin = importlib.import_module("inference.robotwin")
+    assert real.__name__ == "inference.real"
+    assert robotwin.__name__ == "inference.robotwin"
