+import json
+import subprocess
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from main import (
+    find_videos,
+    get_all_gpus,
+    is_navi_case,
+    load_case,
+    video_to_case_id,
+)
+
+
+def test_find_videos_returns_only_sorted_matching_entries(tmp_path):
+    video_dir = tmp_path / "videos"
+    video_dir.mkdir()
+
+    expected_names = [
+        "case_2_combined.mp4",
+        "case_8_combined.mp4",
+        "case_10_combined.mp4",
+    ]
+    for name in reversed(expected_names):
+        (video_dir / name).write_bytes(b"")
+
+    (video_dir / "case_2.mp4").write_bytes(b"")
+    (video_dir / "case_3_combined.mov").write_bytes(b"")
+    (video_dir / "other_case_4_combined.mp4").write_bytes(b"")
+
+    nested = video_dir / "nested"
+    nested.mkdir()
+    (nested / "case_1_combined.mp4").write_bytes(b"")
+
+    assert find_videos(str(video_dir)) == sorted(
+        str(video_dir / name) for name in expected_names
+    )
+
+
+@pytest.mark.parametrize(
+    ("video_path", "expected"),
+    [
+        ("case_1_combined.mp4", "1"),
+        ("/tmp/videos/case_alpha_combined.mp4", "alpha"),
+        ("relative/path/case_001_combined.mp4", "001"),
+    ],
+)
+def test_video_to_case_id_extracts_identifier(video_path, expected):
+    assert video_to_case_id(video_path) == expected
+
+
+def test_load_case_returns_decoded_json_document(tmp_path):
+    case_data = {
+        "id": 12,
+        "name": "室内场景",
+        "interactions": [
+            {"type": "navigation", "action": "forward"},
+            {"type": "event_edit", "action": "turn on the light"},
+        ],
+    }
+    (tmp_path / "case_12.json").write_text(
+        json.dumps(case_data, ensure_ascii=False),
+        encoding="utf-8",
+    )
+
+    assert load_case(12, str(tmp_path)) == case_data
+
+
+def test_load_case_returns_none_when_expected_file_is_absent(tmp_path):
+    assert load_case("missing", str(tmp_path)) is None
+
+
+def test_load_case_propagates_json_decode_error(tmp_path):
+    (tmp_path / "case_bad.json").write_text("{not valid json", encoding="utf-8")
+
+    with pytest.raises(json.JSONDecodeError):
+        load_case("bad", str(tmp_path))
+
+
+@pytest.mark.parametrize(
+    "case_data",
+    [
+        {"interactions": [{"action": "W"}]},
+        {"interactions": [{"action": "left"}]},
+        {"interactions": [{"action": "backward"}]},
+        {"interactions": [{"action": "cam_down"}]},
+        {"interactions": [{"type": "navigation"}]},
+        {
+            "interactions": [
+                {"type": "event_edit", "action": "open the door"},
+                {"type": "subject_action", "action": "forward"},
+            ]
+        },
+    ],
+)
+def test_is_navi_case_recognizes_navigation_cases(case_data):
+    assert is_navi_case(case_data) is True
+
+
+@pytest.mark.parametrize(
+    "case_data",
+    [
+        None,
+        {},
+        {"interactions": []},
+        {"interactions": [{"type": "event_edit", "action": "open the door"}]},
+        {"interactions": [{"type": "subject_action", "action": "walk forward"}]},
+        {"interactions": [{"action": "Forward"}]},
+        {"interactions": [{"action": "w"}]},
+    ],
+)
+def test_is_navi_case_rejects_non_navigation_cases(case_data):
+    assert is_navi_case(case_data) is False
+
+
+@pytest.mark.parametrize(
+    ("device_count", "expected"),
+    [
+        (4, [0, 1, 2, 3]),
+        (1, [0]),
+        (0, [0]),
+    ],
+)
+def test_get_all_gpus_uses_cuda_device_count(monkeypatch, device_count, expected):
+    fake_torch = SimpleNamespace(
+        cuda=SimpleNamespace(device_count=lambda: device_count)
+    )
+    monkeypatch.setitem(sys.modules, "torch", fake_torch)
+
+    assert get_all_gpus() == expected
+
+
+def test_get_all_gpus_falls_back_to_gpu_zero_on_detection_error(monkeypatch):
+    def raise_detection_error():
+        raise RuntimeError("CUDA detection failed")
+
+    fake_torch = SimpleNamespace(
+        cuda=SimpleNamespace(device_count=raise_detection_error)
+    )
+    monkeypatch.setitem(sys.modules, "torch", fake_torch)
+
+    assert get_all_gpus() == [0]
+
+
+def test_main_cli_help_lists_documented_entry_point_options():
+    result = subprocess.run(
+        [sys.executable, "-m", "main", "--help"],
+        capture_output=True,
+        text=True,
+        timeout=20,
+        check=False,
+    )
+
+    assert result.returncode == 0
+    help_output = result.stdout + result.stderr
+    for option in ("--model", "--phase", "--video", "--case"):
+        assert option in help_output
