+import tempfile
+from importlib import import_module
+
+
+latex_to_omml_module = import_module("ocr_kb.scripts.latex_to_omml")
+
+
+def test_latex_to_omml_returns_none_when_pandoc_is_unavailable(
+    monkeypatch, tmp_path
+):
+    monkeypatch.setenv("PATH", str(tmp_path))
+    monkeypatch.setattr(tempfile, "tempdir", str(tmp_path))
+
+    result = latex_to_omml_module.latex_to_omml("x^2")
+
+    assert result is None
